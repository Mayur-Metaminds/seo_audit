# Crawl policy: dig robots.txt Sitemap: + /sitemap.xml, then any nested .xml those files list.
# Never guess child sitemap paths (main.xml, post-sitemap.xml, …) and never invent pages from links.
# Without a usable sitemap, only the seed URL is audited.


# Vercel only: cap pages so the function finishes within maxDuration
# AUDIT_MAX_PAGES=150

# Allow scanning localhost / local development URLs (true / false). Default is false.
ALLOW_LOCALHOST=false

# --- Google PageSpeed Insights (Lighthouse lab + CrUX field) ---
# How to get a key:
# 1. Open https://console.cloud.google.com/
# 2. Create/select a project
# 3. APIs & Services → Library → search "PageSpeed Insights API" → Enable
# 4. APIs & Services → Credentials → Create credentials → API key
# 5. Paste the key below (also restrict the key to PageSpeed Insights API)
# If empty: audit still runs using heuristic page-speed checks (no break)
# IMPORTANT: Google cannot audit localhost / private IPs — use a public URL for real PSI.
GOOGLE_PSI_API_KEY=
GOOGLE_PSI_API_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed
ENABLE_PSI=true
# How many pages get real PSI (sample). Cap 300 = one rate-limit window.
PSI_MAX_URLS=30
# Parallel in-flight PSI calls (max 300). Combined with rate limiter below.
PSI_CONCURRENCY=30
# Hard ceiling: max PSI starts per 100 seconds (Google-safe boundary)
PSI_RATE_LIMIT=300

# --- Headless Chromium for post-JS on-page SEO ---
ENABLE_HEADLESS_RENDER=true
RENDER_MAX_PAGES=40
# Parallel Chromium pages (keep lower — memory heavy)
RENDER_CONCURRENCY=4

# --- Grammar / writing suggestions (LanguageTool) — advisory only, NOT scored ---
# Free public endpoint works without a key (lower quota). Optional Premium key:
# https://languagetool.org/http-api/
ENABLE_GRAMMAR=true
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_API_KEY=
LANGUAGETOOL_USERNAME=
GRAMMAR_MAX_PAGES=10
# Parallel grammar checks (use 2–3 without a key; higher with Premium)
GRAMMAR_CONCURRENCY=3
GRAMMAR_LANGUAGE=en-US
